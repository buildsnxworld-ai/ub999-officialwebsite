rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile and create deposit/withdraw requests
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Deposit requests
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // Withdraw requests
    match /withdrawals/{withdrawId} {
      allow read, write: if true;
    }

    // System settings (payment numbers, notice, win rate)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // VIP Signals pushed by Admin and read by Signal App
    match /signals/{signalId} {
      allow read, write: if true;
    }
  }
}
